# Dependencies
node_modules/

# Build output
frontend/dist/
frontend/.env
frontend/.env.local

# Backend secrets
backend/.env
backend/.gemini-key
backend/gcp-sa.json
backend/gcp-oauth.json
backend/gcp-token.json
backend/_tmp/ga-snapshot/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# MCP (contains Supabase PAT)
.mcp.json

# Backend tmp cache
backend/_tmp/

# Local Supabase backups (GitHub Actions stores in artifact, not git)
backend/_backup/

# Cache directories (PDF, probe, image extraction intermediates)
backend/.pdf-cache/
backend/_cache/
backend/[0-9][0-9][0-9][0-9][0-9][0-9]_*/

# Tesseract OCR training data (large binary, auto-downloaded by tesseract.js if needed)
backend/*.traineddata

# Historical / one-off scripts (not in active rotation)
backend/scripts/historical/
backend/fix_batch_*.py

# Android (Capacitor) — exclude build artifacts, keep source
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/build/
frontend/android/build/
frontend/android/captures/
frontend/android/.idea/
frontend/android/app/src/main/assets/public/
frontend/android/app/release/

# 上架素材(Play/App Store 截圖、主視覺、設計稿) — 本機保存不入庫
store-assets/

# 公職爬蟲的中間檔——正式資料在 shared-banks/，這支只是抓下來給 rebuild 用。
# 它的選項是舊解析法切的（會切壞），不能讓 questions-*.json 的 glob 掃到。
backend/questions-civil-senior.json

# 下載的 Cloud Billing 費用表 CSV（含帳單帳戶 ID 與應付憑據號碼，不入庫）
backend/_finance/

# 題庫備份檔（questions-*.json.bak）——正本在 git history，不需要再進版控。
# 2026-10-26：連同 backend/_tmp 一起 untrack，當時追蹤量 3.2 GB → 575 MB。
# backend/_tmp 的規則上面早就有了，但那些檔是在加規則之前就 commit 進去的，
# gitignore 不會 untrack 既有檔案，要 git rm -r --cached 才會生效。
*.bak

# 2026-10-27 untrack：舊的題庫備份與爬蟲中間檔（本機還在，--cached 只動索引）。
# backend/_archive 刻意**不**列入 —— 那是封存的申論／計算卷（94 份 post-essay
# + state-essay.json），archive-post-essay.js 與 scrape-taipower-essay.js 會用，
# 日後要做申論練習功能，重抓成本高。
backend/_backup_*/
backend/tmp-gap/
backend/tmp/
